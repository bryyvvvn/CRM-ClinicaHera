# Replace with your Neon (or other cloud PostgreSQL) connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# WhatsApp Cloud API
# Verify token: inventa un string y pégalo igual en Meta → WhatsApp → Configuration
WHATSAPP_VERIFY_TOKEN="replace-with-your-verify-token"
# Temporary access token (API Setup) o token de sistema
WHATSAPP_TOKEN=""
# Phone number ID del número de prueba (API Setup)
WHATSAPP_PHONE_NUMBER_ID=""
# App secret (Configuración de la app). Vacío = no se valida X-Hub-Signature-256
WHATSAPP_APP_SECRET=""

# Frontend origin for CORS / Socket.io
FRONTEND_URL="http://localhost:5173"

PORT=3000

# MediLink / Dentalink API (Authorization: Token ...)
MEDILINK_BASE_URL="https://api.medilink2.healthatom.com/api/v5"
# Escritura de citas en sucursal dental (Dentalink v1)
MEDILINK_WRITE_BASE_URL="https://api.dentalink.healthatom.com/api/v1"
MEDILINK_TOKEN=""
# Opcionales: si el lookup de sucursal/sillón/estado no calza
# MEDILINK_DEFAULT_SUCURSAL_ID=
# MEDILINK_DEFAULT_PROFESIONAL_ID=
# MEDILINK_DEFAULT_SILLON_ID=
# MEDILINK_ESTADO_NUEVA_CITA=
# MEDILINK_ESTADO_CONFIRMADA=
# MEDILINK_ESTADO_ANULADA=

# DeepSeek (el prompt NO se configura en la web; vive en backend/src/ai/ai.prompt.ts)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"
